# 과목별 세부특기사항 AI 초안 provider — mock(기본, Ollama 불필요) | ollama
#
# 세부특기사항 파이프라인은 브라우저(클라이언트 컴포넌트)에서 실행되므로, 앱 UI에서
# Ollama를 켜려면 반드시 NEXT_PUBLIC_AI_DRAFT_PROVIDER=ollama를 설정해야 한다.
# AI_DRAFT_PROVIDER는 Next.js 클라이언트 번들에 인라인되지 않으므로 이것만 설정하면
# 브라우저에서는 여전히 mock이 사용된다 — 서버 전용 코드/테스트처럼 process.env를
# 직접 읽는 컨텍스트를 위한 값이다 (resolveDraftProviderMode는 NEXT_PUBLIC_* 우선,
# 없으면 AI_DRAFT_PROVIDER로 폴백).
AI_DRAFT_PROVIDER=mock

# 앱 UI(브라우저)에서 Ollama를 활성화하려면 이 값을 ollama로 설정 — 기본은 mock이라
# Ollama 없이도 데모가 동작함
NEXT_PUBLIC_AI_DRAFT_PROVIDER=mock

# NEXT_PUBLIC_AI_DRAFT_PROVIDER=ollama일 때 /api/ai/draft가 호출할 로컬 Ollama 서버 주소
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 사용할 Ollama 모델 (사전에 `ollama pull <model>` 필요)
OLLAMA_MODEL=llama3.2

# --- 오프라인 학습 스모크 (앱 UI와 무관) ---
# PROMPT_SLOTS를 promptRegistry.ts에 채운 뒤 `npm run train:smoke`
TRAIN_SMOKE_ENABLED=true
TRAIN_SMOKE_MAX_GOLDS=2
TRAIN_SMOKE_ATTEMPTS_PER_PROMPT=2
# TRAIN_GOLD_PATH=data/subject-details/gold.example.jsonl
