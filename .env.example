# 과목별 세부특기사항 AI 초안 provider — mock(기본, Ollama 불필요) | ollama
AI_DRAFT_PROVIDER=mock

# 클라이언트 번들에서 provider 모드를 읽어야 하는 경우에만 설정 (보통 AI_DRAFT_PROVIDER만으로 충분)
# NEXT_PUBLIC_AI_DRAFT_PROVIDER=mock

# AI_DRAFT_PROVIDER=ollama일 때 /api/ai/draft가 호출할 로컬 Ollama 서버 주소
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 사용할 Ollama 모델 (사전에 `ollama pull <model>` 필요)
OLLAMA_MODEL=llama3.2
