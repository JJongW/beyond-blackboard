# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent skills (not shipped)
.agents/
skills-lock.json

# Cursor hook runtime state (keep skills/rules/commands trackable)
.cursor/hooks/state/

# legacy sticker icon rasters (UI icons are SVG)
public/images/icons/

# unused design dumps (CrepassIcon is SVG; mark uses crepass-app-icon)
public/images/crepass-icon-sheet.png
public/images/crepass-mark.png
public/images/crepass-ui-icons.png
